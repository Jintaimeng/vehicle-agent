# 复制为 deployments/online.env 后，只需在这一份文件里维护在线运行参数。
# 不要提交 online.env；它已加入 .gitignore。

# API 自身
VEHICLE_AGENT_HOST=0.0.0.0
VEHICLE_AGENT_PORT=8000
VEHICLE_AGENT_API_TOKEN=replace-me
VEHICLE_AGENT_CHECKPOINT_PATH=/data/checkpoints.sqlite

# 远程文本模型：必须兼容 GET /models 与 POST /chat/completions
# Gemini Key：两个 BASE_URL 改为 https://generativelanguage.googleapis.com/v1beta/openai
# 两个 MODEL_NAME 可用 gemini-3.5-flash-lite；须真实请求验证，不能只看 /models。
VEHICLE_AGENT_MODEL_BACKEND=openai
VEHICLE_AGENT_MODEL_BASE_URL=https://api.openai.com/v1
VEHICLE_AGENT_MODEL_API_KEY=replace-me
VEHICLE_AGENT_MODEL_NAME=gpt-4.1-mini

# 远程视觉大模型，可与文本模型使用同一个端点和模型
VEHICLE_AGENT_REVIEW_BACKEND=vlm
VEHICLE_AGENT_VLM_BASE_URL=https://api.openai.com/v1
VEHICLE_AGENT_VLM_API_KEY=replace-me
VEHICLE_AGENT_VLM_MODEL_NAME=gpt-4.1-mini

# 容器内 YOLO；权重已在在线镜像构建阶段缓存
VEHICLE_AGENT_VISION_BACKEND=yolo
VEHICLE_AGENT_YOLO_WEIGHTS=/app/yolov8n.pt
VEHICLE_AGENT_VISION_STORE_DIR=/data/vision

# 视频仍使用定样本；接入真实视频时再切换为 ffmpeg
VEHICLE_AGENT_VIDEO_BACKEND=fixture

# Kafka 常驻消费
VEHICLE_AGENT_INGEST=kafka
VEHICLE_AGENT_KAFKA_BOOTSTRAP=kafka:29092
KAFKA_ADVERTISED_HOST=127.0.0.1

# Neo4j 与 Qdrant
NEO4J_AUTH=neo4j/vehicle-agent-local
VEHICLE_AGENT_GRAPH_BACKEND=neo4j
VEHICLE_AGENT_NEO4J_URI=bolt://neo4j:7687
VEHICLE_AGENT_NEO4J_USER=neo4j
VEHICLE_AGENT_NEO4J_PASSWORD=vehicle-agent-local
VEHICLE_AGENT_REGULATION_BACKEND=qdrant
VEHICLE_AGENT_QDRANT_URL=http://qdrant:6333

# 工具和执行预算
VEHICLE_AGENT_TOOL_BACKEND=local
VEHICLE_AGENT_REQUEST_TIMEOUT_SECONDS=120
VEHICLE_AGENT_MAX_RETRIES=2
VEHICLE_AGENT_MAX_TOOL_CALLS=8
VEHICLE_AGENT_MAX_MODEL_CALLS=4
VEHICLE_AGENT_MAX_TOKENS=4000
VEHICLE_AGENT_MAX_ELAPSED_SECONDS=180
VEHICLE_AGENT_REVIEW_CONFIDENCE_THRESHOLD=0.6
VEHICLE_AGENT_PROMPT_VERSION=report-v6

# 仅供宿主机验收脚本读取，不影响容器应用配置
VEHICLE_AGENT_YOLO_IMAGE=data/vision-sample.jpg
VEHICLE_AGENT_VLM_IMAGE=data/vision-sample.jpg
